<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.back.MatriculaController">
   <children>
      <Label layoutX="24.0" layoutY="22.0" text="Cadastro de Matrícula" />

      <Label layoutX="60.0" layoutY="70.0" text="Aluno" />
      <Label layoutX="60.0" layoutY="111.0" text="Plano" />
      <Label layoutX="60.0" layoutY="152.0" text="Data Início" />
      <Label layoutX="60.0" layoutY="193.0" text="Data Vencimento" />

      <TextField fx:id="txtAluno" layoutX="175.0" layoutY="66.0" prefWidth="250.0" />
      <TextField fx:id="txtPlano" layoutX="175.0" layoutY="107.0" prefWidth="250.0" />
      <TextField fx:id="txtDataInicio" layoutX="175.0" layoutY="148.0" prefWidth="250.0" promptText="dd/mm/aaaa" />
      <TextField fx:id="txtDataVencimento" layoutX="175.0" layoutY="189.0" prefWidth="250.0" promptText="dd/mm/aaaa" />

      <Button layoutX="24.0" layoutY="354.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
      <Button layoutX="501.0" layoutY="354.0" mnemonicParsing="false" onAction="#salvarMatricula" text="Salvar" />
   </children>
</AnchorPane>
