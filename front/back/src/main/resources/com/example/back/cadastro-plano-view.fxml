<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.back.PlanoController">
   <children>
      <Label layoutX="24.0" layoutY="22.0" text="Cadastro de Plano" />

      <Label layoutX="60.0" layoutY="70.0" text="Nome" />
      <Label layoutX="60.0" layoutY="111.0" text="Descrição" />
      <Label layoutX="60.0" layoutY="152.0" text="Valor" />
      <Label layoutX="60.0" layoutY="193.0" text="Duração em meses" />

      <TextField fx:id="txtNome" layoutX="175.0" layoutY="66.0" prefWidth="250.0" />
      <TextField fx:id="txtDescricao" layoutX="175.0" layoutY="107.0" prefWidth="250.0" />
      <TextField fx:id="txtValor" layoutX="175.0" layoutY="148.0" prefWidth="250.0" />
      <TextField fx:id="txtDuracaoEmMeses" layoutX="175.0" layoutY="189.0" prefWidth="250.0" />

      <Button layoutX="24.0" layoutY="354.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
      <Button layoutX="501.0" layoutY="354.0" mnemonicParsing="false" onAction="#salvarPlano" text="Salvar" />
   </children>
</AnchorPane>
